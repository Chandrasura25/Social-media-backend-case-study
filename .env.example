# Required
MONGODB_URI=mongodb://localhost:27017/social-media
JWT_SECRET=change-me-to-a-long-random-string

# Optional
PORT=3000
JWT_EXPIRES_IN=1h
# Response caching for /posts and /feed. Leave unset to disable.
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
# Cloudinary media hosting. Leave unset to store uploads on local disk under /uploads.
CLOUD_NAME=
API_KEY=
API_SECRET=
